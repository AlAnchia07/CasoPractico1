

@model IEnumerable<CasoPractico1.Models.Producto>

@{
    ViewData["Title"] = "Productos";
}

<h1>Productos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo producto</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th>Categoría</th>
            <th>Precio</th>
            <th>Existencia</th>
            <th>Unidad de medida</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var producto in Model)
        {
            <tr>
                <td>@producto.Codigo</td>
                <td>@producto.Nombre</td>
                <td>@producto.Categoria</td>
                <td>@producto.Precio.ToString("N2")</td>
                <td>@producto.Existencia.ToString("N2")</td>
                <td>
                    @(producto.UnidadMedida != null
                        ? $"{producto.UnidadMedida.Nombre} ({producto.UnidadMedida.Abreviatura})"
                        : "Sin unidad")
                </td>
                <td>@(producto.Activo ? "Activo" : "Inactivo")</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@producto.Id"
                       class="btn btn-info btn-sm">Detalles</a>

                    <a asp-action="Edit"
                       asp-route-id="@producto.Id"
                       class="btn btn-warning btn-sm">Editar</a>

                    <a asp-action="Delete"
                       asp-route-id="@producto.Id"
                       class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

